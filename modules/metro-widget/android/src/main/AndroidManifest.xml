<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <application>
    <receiver android:name=".MetroWidgetReceiver" android:exported="false" android:label="@string/metro_widget_compact">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/metro_widget_compact" />
    </receiver>
    <receiver android:name=".MetroWideWidgetReceiver" android:exported="false" android:label="@string/metro_widget_wide">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/metro_widget_wide" />
    </receiver>
  </application>
</manifest>
